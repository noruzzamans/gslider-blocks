# Version control and editor configurations
/.git
/.github
/.gitignore
/.gitattributes
/.agents
/.vscode
/.distignore
/.editorconfig
/.eslintrc*
/.eslintignore
/.stylelint*
/.stylelintignore
/.nvmrc
/.npmrc
/.wp-env.json
/.all-contributorsrc
/.coderabbit.yaml
/.phpunit.result.cache
/jsconfig.json

# Development documentation and contributor guidelines
/.wordpress-org/
/docs/
/*.md

# Automated tests and test suites
/tests/
/phpunit.xml*

# Node dependencies and root source code (compiled output is in /build/ and /assets/admin/)
/node_modules/
/src/
/admin/
/packages/
/scripts/
/storybook/
/storybook-static/

# Build configuration and dependencies manifests
/webpack.config.js
/webpack.config.admin.js
/webpack.zip.js
/package.json
/package-lock.json
/composer.json
/composer.lock

# Vendor internal documentation and development artifacts
/vendor/**/.*
/vendor/**/*.md
/vendor/**/composer.json
/vendor/**/composer.lock
/vendor/**/phpunit*
/vendor/**/sebastian*

# Archives and operating system artifacts
*.zip
*.log
.DS_Store
Thumbs.db
