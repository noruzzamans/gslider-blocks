{
  "name": "@gslider/mcp-server",
  "version": "1.0.3",
  "description": "Official Model Context Protocol (MCP) server for GSlider Blocks — AI-assisted Gutenberg slider & carousel generation and design",
  "license": "GPL-2.0-or-later",
  "homepage": "https://wordpress.org/plugins/gslider-blocks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/noruzzamans/gslider-blocks.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/noruzzamans/gslider-blocks/issues"
  },
  "keywords": [
    "wordpress",
    "gutenberg",
    "gslider",
    "slider",
    "carousel",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "antigravity",
    "ai",
    "blocks"
  ],
  "engines": {
    "node": ">=22.22.2"
  },
  "author": "Noruzzaman",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "gslider-mcp": "dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "generate-schemas": "node scripts/extract-schemas.js",
    "test": "node scripts/test-drift.js",
    "build": "node scripts/bundle-core-saves.js && node scripts/bundle-blocks.js && node scripts/extract-schemas.js && tsc && mkdir -p dist/core/schemas && cp src/core/schemas/*.json dist/core/schemas/",
    "watch": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "test:generate": "node scripts/test-generate.js",
    "test:patterns": "node scripts/test-patterns.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.1",
    "zod": "^4.6.7",
    "@wordpress/blocks": "16.2.0",
    "@wordpress/block-editor": "18.1.0",
    "jsdom": "30.1.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.8",
    "esbuild": "^0.28.2",
    "@wordpress/block-library": "10.5.0",
    "typescript": "^7.0.2"
  }
}
